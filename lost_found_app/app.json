{
  "expo": {
    "name": "lost_found_app",
    "slug": "findly",
    "owner": "beewan",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "lostfoundapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
